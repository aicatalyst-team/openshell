# AutoPoC UBI build for the OpenShell gateway, compiled from the pinned source.
#
# Replicates the upstream release build: x86_64-unknown-linux-gnu target with
# the default feature set (telemetry + in-tree compute drivers; the Helm chart
# selects the Kubernetes driver at runtime and disables telemetry via
# server.telemetryEnabled=false). z3 is built from the crate's vendored source
# (vendored-z3) instead of a distro package, matching the project's
# source-built z3 practice.
#
# Builder stage: UBI9 with the Rust 1.95.0 toolchain (rustup) and the native
# toolchain required by the workspace:
#   - gcc/make/cmake/pkg-config: aws-lc-sys and vendored z3 (cmake + C compiler)
#   - clang/libclang: z3-sys bindgen

FROM registry.access.redhat.com/ubi9/ubi AS builder

ENV CARGO_HOME=/usr/local/cargo \
    RUSTUP_HOME=/usr/local/rustup \
    PATH=/usr/local/cargo/bin:$PATH

USER 0
RUN dnf install -y \
        ca-certificates \
        curl-minimal \
        gcc gcc-c++ make cmake pkg-config \
        clang clang-devel libclang \
        openssl-devel \
        perl-core \
    && dnf clean all \
    && rm -rf /var/cache/dnf

RUN curl -fsSL https://sh.rustup.rs -o /tmp/rustup-init.sh \
    && . /tmp/rustup-init.sh -y --profile minimal --default-toolchain 1.95.0 \
    && rm -f /tmp/rustup-init.sh

WORKDIR /opt/app-root/src
COPY . .

RUN cargo build --release --locked \
        --target x86_64-unknown-linux-gnu \
        -p openshell-gateway --bin openshell-gateway \
        --features vendored-z3

# Runtime stage: minimal UBI9 (glibc present for the GNU-linked binary).
FROM registry.access.redhat.com/ubi9/ubi-minimal

COPY --from=builder /opt/app-root/src/target/x86_64-unknown-linux-gnu/release/openshell-gateway /usr/local/bin/openshell-gateway

RUN chgrp -R 0 /usr/local/bin && chmod -R g=u /usr/local/bin

EXPOSE 8080 8081 9090

USER 1001

ENTRYPOINT ["/usr/local/bin/openshell-gateway"]
CMD ["--bind-address", "0.0.0.0", "--port", "8080"]
