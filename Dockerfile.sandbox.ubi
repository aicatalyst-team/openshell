# Adapted from the operator's same-revision reference Dockerfile.
FROM registry.access.redhat.com/ubi9/ubi AS builder
ENV CARGO_HOME=/usr/local/cargo RUSTUP_HOME=/usr/local/rustup PATH=/usr/local/cargo/bin:$PATH CC=x86_64-linux-musl-gcc CARGO_TARGET_X86_64_UNKNOWN_LINUX_MUSL_LINKER=x86_64-linux-musl-gcc
USER 0
RUN dnf install -y ca-certificates curl-minimal gcc gcc-c++ make cmake pkg-config clang clang-devel openssl-devel perl-core && dnf clean all && rm -rf /var/cache/dnf
RUN curl -fsSL https://musl.cc/x86_64-linux-musl-cross.tgz -o /tmp/musl-cross.tgz && tar xzf /tmp/musl-cross.tgz -C /opt && ln -sf /opt/x86_64-linux-musl-cross/bin/x86_64-linux-musl-gcc /usr/local/bin/x86_64-linux-musl-gcc && rm -f /tmp/musl-cross.tgz
RUN curl -fsSL https://sh.rustup.rs -o /tmp/rustup-init.sh && . /tmp/rustup-init.sh -y --profile minimal --default-toolchain 1.95.0 && rustup target add x86_64-unknown-linux-musl && rm -f /tmp/rustup-init.sh
WORKDIR /opt/app-root/src
COPY . .
RUN cargo build --release --locked --target x86_64-unknown-linux-musl -p openshell-sandbox --bin openshell-sandbox
FROM registry.access.redhat.com/ubi9/ubi-minimal
COPY --from=builder /opt/app-root/src/target/x86_64-unknown-linux-musl/release/openshell-sandbox /openshell-sandbox
RUN mkdir -p /opt/app-root && chgrp -R 0 /opt/app-root /openshell-sandbox && chmod -R g=u /opt/app-root /openshell-sandbox
USER 1001
ENTRYPOINT ["/openshell-sandbox"]
