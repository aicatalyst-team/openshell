# Adapted from the operator's same-revision reference Dockerfile.
FROM registry.access.redhat.com/ubi9/ubi AS builder
ENV CARGO_HOME=/usr/local/cargo RUSTUP_HOME=/usr/local/rustup PATH=/usr/local/cargo/bin:$PATH
USER 0
RUN dnf install -y ca-certificates curl-minimal gcc gcc-c++ make cmake pkg-config gcc-toolset-15-gcc-c++ clang clang-devel openssl-devel perl-core && dnf clean all && rm -rf /var/cache/dnf
ENV CC=/opt/rh/gcc-toolset-15/root/usr/bin/gcc CXX=/opt/rh/gcc-toolset-15/root/usr/bin/g++ CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_LINKER=/opt/rh/gcc-toolset-15/root/usr/bin/gcc
RUN curl -fsSL https://sh.rustup.rs -o /tmp/rustup-init.sh && . /tmp/rustup-init.sh -y --profile minimal --default-toolchain 1.95.0 && rm -f /tmp/rustup-init.sh
WORKDIR /opt/app-root/src
COPY . .
RUN cargo build --release --locked --target x86_64-unknown-linux-gnu -p openshell-gateway --bin openshell-gateway --features vendored-z3
FROM registry.access.redhat.com/ubi9/ubi-minimal
COPY --from=builder /opt/app-root/src/target/x86_64-unknown-linux-gnu/release/openshell-gateway /usr/local/bin/openshell-gateway
RUN mkdir -p /opt/app-root && chgrp -R 0 /opt/app-root /usr/local/bin && chmod -R g=u /opt/app-root /usr/local/bin
EXPOSE 8080 8081 9090
USER 1001
ENTRYPOINT ["/usr/local/bin/openshell-gateway"]
CMD ["--bind-address", "0.0.0.0", "--port", "8080"]
